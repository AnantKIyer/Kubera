# Copy to .env.local and fill in your values.

# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Clerk (Dashboard → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk path helpers
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# On the Convex deployment (not Next.js), set the Clerk Frontend API URL:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://verb-noun-00.clerk.accounts.dev"
# Activate the Convex integration in the Clerk Dashboard first.

# Field encryption (set in Convex, not .env.local):
#   node scripts/generate-encryption-key.mjs
#   npx convex env set DATA_ENCRYPTION_KEY "<generated-key>"
#   npm run test:encryption
